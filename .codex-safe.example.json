{
  "$schema": "https://raw.githubusercontent.com/jiying2007/codex-safe-core/d95f67cc61ce66c16e2aa440829655919e906a75/codex-safe.schema.json",
  "schemaVersion": 4,
  "review": {
    "language": "zh-CN",
    "maxDiffBytes": 524288,
    "maxFindings": 30,
    "severityThreshold": "low",
    "confidenceThreshold": 0.7,
    "timeoutSeconds": 120,
    "extraInstructions": "重点检查资源生命周期、并发和错误处理。",
    "rules": {
      "requireTestsForCodeChanges": true,
      "codePathPrefixes": [
        "src/"
      ],
      "testPathPrefixes": [
        "test/",
        "tests/"
      ],
      "forbiddenPathPrefixes": []
    }
  },
  "change": {},
  "reviewService": {
    "maxContextBytes": 131072,
    "maxContextFiles": 20,
    "contextLines": 40,
    "skipGeneratedFiles": true,
    "blockUnreviewableFiles": false
  }
}
