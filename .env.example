# Optional config path override. Non-secret settings belong in config.json.
# CODEX_REVIEW_CONFIG_FILE=/etc/codex-review/config.json

# Required GitLab credentials.
GITLAB_API_TOKEN=replace-with-project-or-group-access-token
GITLAB_WEBHOOK_SIGNING_TOKEN=whsec_replace_with_32_byte_base64_signing_token

# Optional API-key auth. Otherwise run `codex login` as the service/Runner user.
# OPENAI_API_KEY=replace-me
