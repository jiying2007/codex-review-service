# Listener. Keep loopback when TLS is terminated by an internal reverse proxy.
HOST=127.0.0.1
PORT=8787
CODEX_REVIEW_DATA_DIR=/var/lib/codex-review

# GitLab Self-Managed.
GITLAB_BASE_URL=https://gitlab.example.internal
GITLAB_API_TOKEN=replace-with-project-or-group-access-token
# Explicit IDs enable full periodic reconciliation. Use * only for webhook-only discovery.
GITLAB_PROJECT_ALLOWLIST=123,456
GITLAB_REQUEST_TIMEOUT_MS=30000
GITLAB_MAX_PAGES=200
GITLAB_STATUS_RETRIES=5
GITLAB_REQUESTS_PER_SECOND=20
GITLAB_CIRCUIT_FAILURE_THRESHOLD=8
GITLAB_CIRCUIT_RESET_MS=30000
GITLAB_STATUS_NAME=codex-review
GITLAB_BIND_STATUS_PIPELINE=true
# Optional URL shown on the external commit status.
# GITLAB_STATUS_TARGET_URL=https://review.example.internal/

# GitLab 19+ Standard Webhooks signing token (recommended).
GITLAB_WEBHOOK_SIGNING_TOKEN=whsec_replace_with_32_byte_base64_signing_token
GITLAB_WEBHOOK_EXPECTED_INSTANCE=https://gitlab.example.internal
REQUIRE_GITLAB_INSTANCE_HEADER=true
# Legacy fallback for older GitLab / migration only:
# GITLAB_WEBHOOK_SECRET_TOKEN=replace-with-legacy-secret-token
WEBHOOK_MAX_SKEW_SECONDS=300
WEBHOOK_MAX_BODY_BYTES=1048576
GITLAB_BOT_USERNAME=codex-review-bot
# 30=Developer, 40=Maintainer. 0 disables manual-command membership enforcement.
MANUAL_REVIEW_MIN_ACCESS_LEVEL=30

# Codex.
CODEX_PATH=codex
CODEX_HOME=/home/codex-review/.codex
# Optional API-key auth instead of managed Codex login:
# OPENAI_API_KEY=replace-me
# CODEX_MODEL=
# Production can pin a tested Codex CLI version/series with a regex.
CODEX_VERSION_POLICY=warn
# CODEX_ALLOWED_VERSION_PATTERN=^codex-cli 0\.\d+\.\d+$

# Review policy hard ceilings. Target-branch .codex-review.json may only narrow these.
REVIEW_LANGUAGE=zh-CN
REVIEW_TIMEOUT_SECONDS=180
JOB_TIMEOUT_SECONDS=900
MAX_JOB_ATTEMPTS=3
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=60000
MAX_DIFF_BYTES=1048576
MAX_REVIEW_CHUNKS=8
MAX_FINDINGS=40
MAX_PUBLISHED_FINDINGS=40
MIN_CONFIDENCE=0.7
BLOCKING_SEVERITY=high
PROJECT_POLICY_ENABLED=true
PROJECT_POLICY_FILE=.codex-review.json
PROJECT_POLICY_MAX_BYTES=65536

# Immutable bounded context is read by the controller from exact target/source snapshot SHAs.
REVIEW_CONTEXT_ENABLED=true
MAX_CONTEXT_BYTES=262144
MAX_CONTEXT_FILES=12
CONTEXT_LINES=20

# Coverage classification.
SKIP_GENERATED_FILES=true
BLOCK_UNREVIEWABLE_FILES=false

# Cost / capacity governance. 0 disables a budget.
MR_MAX_TOKEN_BUDGET=0
PROJECT_DAILY_TOKEN_BUDGET=0

# Queue / review workers.
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=1000
MAX_QUEUE_DEPTH=200
REVIEW_DEBOUNCE_MS=3000
REVIEW_DRAFT_MERGE_REQUESTS=false

# Durable GitLab publication workers. Review execution never waits for publication retries.
PUBLISHER_CONCURRENCY=2
PUBLISHER_POLL_INTERVAL_MS=500
MAX_PUBLISH_ATTEMPTS=8

# Data lifecycle / reconciliation.
DATA_RETENTION_DAYS=30
WEBHOOK_RETENTION_DAYS=7
MAINTENANCE_INTERVAL_MS=3600000
RECONCILE_INTERVAL_MS=300000
READINESS_CACHE_MS=5000
AUTO_RESOLVE_OBSOLETE=true
TRIGGER_ON_OPEN=true
TRIGGER_ON_PUSH=true
TRIGGER_ON_REOPEN=true

# Optional OTLP/HTTP JSON trace export. No source code/prompts/raw model output are exported.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.internal:4318
# OTEL_SERVICE_NAME=codex-review-service
# OTEL_EXPORT_TIMEOUT_MS=3000
