# Optional config path override. Without it, direct user-mode runtime follows XDG:
# ${XDG_CONFIG_HOME:-$HOME/.config}/codex-review/config.json
# System-level deployment explicitly pins /etc/codex-review/config.json.
# CODEX_REVIEW_CONFIG_FILE=/custom/path/config.json

# Required GitLab credentials. Set either VALUE or VALUE_FILE, never both.
# File-backed secrets are recommended for production and must use absolute paths.
GITLAB_API_TOKEN_FILE=/etc/codex-review/secrets/gitlab-api-token
GITLAB_WEBHOOK_SIGNING_TOKEN_FILE=/etc/codex-review/secrets/gitlab-webhook-signing-token
# GITLAB_API_TOKEN=replace-with-project-or-group-access-token
# GITLAB_WEBHOOK_SIGNING_TOKEN=whsec_replace_with_32_byte_base64_signing_token

# Optional API-key auth. Otherwise run `codex login` as the service/Runner user.
# OPENAI_API_KEY_FILE=/etc/codex-review/secrets/openai-api-key
# OPENAI_API_KEY=replace-me

# Optional IM notification secrets. secretRef maps to CODEX_REVIEW_NOTIFY_<REF>_WEBHOOK.
# Every supported notification secret also accepts a matching *_FILE input.
# CODEX_REVIEW_NOTIFY_EMBEDDED_WEBHOOK_FILE=/etc/codex-review/secrets/notify-embedded-webhook
# CODEX_REVIEW_NOTIFY_EMBEDDED_SIGNING_SECRET_FILE=/etc/codex-review/secrets/notify-embedded-signing-secret
# CODEX_REVIEW_NOTIFY_SERVICE_ALERTS_WEBHOOK_FILE=/etc/codex-review/secrets/notify-service-alerts-webhook
