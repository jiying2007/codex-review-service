# Standard Deployment: keep non-secret settings in /etc/codex-review/config.json.
# Set this only when using a different path:
# CODEX_REVIEW_CONFIG_FILE=/etc/codex-review/config.json

# Required GitLab credentials.
GITLAB_API_TOKEN=replace-with-project-or-group-access-token
GITLAB_WEBHOOK_SIGNING_TOKEN=whsec_replace_with_32_byte_base64_signing_token

# Optional: legacy webhook secret instead of GitLab 19+ Signing Token.
# GITLAB_WEBHOOK_SECRET_TOKEN=replace-with-legacy-secret-token

# Optional: API-key auth. Otherwise run `codex login` as the service user.
# OPENAI_API_KEY=replace-me

# Optional Standard Deployment overrides. Defaults are production-safe.
# HOST=127.0.0.1
# PORT=8787
# CODEX_REVIEW_DATA_DIR=/var/lib/codex-review
# REVIEW_LANGUAGE=zh-CN
# GITLAB_BOT_USERNAME=codex-review-bot
# MANUAL_REVIEW_MIN_ACCESS_LEVEL=30
# MAX_DIFF_BYTES=1048576
# MAX_REVIEW_CHUNKS=8
# MAX_FINDINGS=40
# MIN_CONFIDENCE=0.7
# BLOCKING_SEVERITY=high
# REVIEW_DEBOUNCE_MS=3000
# PUBLISHER_CONCURRENCY=2
# MR_MAX_TOKEN_BUDGET=0
# PROJECT_DAILY_TOKEN_BUDGET=0

# Hardened Deployment: set runner.mode="isolated" in config.json.
# The Controller then uses the Unix socket and must not contain OpenAI/Codex credentials.
# CODEX_RUNNER_SOCKET=/run/codex-review-runner/runner.sock

# Legacy scope input remains supported. When set, it overrides config.json gitlab.projects/groups.
# GITLAB_PROJECT_ALLOWLIST=123,456
# GITLAB_PROJECT_ALLOWLIST=*

# Advanced provider / reliability overrides.
# GITLAB_REQUEST_TIMEOUT_MS=30000
# GITLAB_MAX_PAGES=200
# GITLAB_REQUESTS_PER_SECOND=20
# GITLAB_CIRCUIT_FAILURE_THRESHOLD=8
# GITLAB_CIRCUIT_RESET_MS=30000
# GITLAB_STATUS_NAME=codex-review
# GITLAB_BIND_STATUS_PIPELINE=true
# WORKER_POLL_INTERVAL_MS=1000
# MAX_QUEUE_DEPTH=200
# MAX_JOB_ATTEMPTS=3
# RETRY_BASE_DELAY_MS=1000
# RETRY_MAX_DELAY_MS=60000
# DATA_RETENTION_DAYS=30
# WEBHOOK_RETENTION_DAYS=7
# MAINTENANCE_INTERVAL_MS=3600000
# RECONCILE_INTERVAL_MS=300000
# READINESS_CACHE_MS=5000

# Optional Codex version policy.
# CODEX_VERSION_POLICY=warn
# CODEX_ALLOWED_VERSION_PATTERN=^codex-cli 0\.\d+\.\d+$

# Optional OTLP/HTTP JSON trace export. No source/prompts/raw model output are exported.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.internal:4318
# OTEL_SERVICE_NAME=codex-review-service
