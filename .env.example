HOST=127.0.0.1
PORT=8787
CODEX_REVIEW_DATA_DIR=/var/lib/codex-review

GITLAB_BASE_URL=https://gitlab.example.internal
GITLAB_API_TOKEN=replace-with-project-or-group-access-token
GITLAB_WEBHOOK_SIGNING_TOKEN=whsec_replace_with_gitlab_signing_token
# Legacy fallback for older GitLab or migration periods:
# GITLAB_WEBHOOK_SECRET_TOKEN=replace-with-secret-token
GITLAB_BOT_USERNAME=codex-review-bot

CODEX_PATH=codex
CODEX_HOME=/home/codex-review/.codex
# Optional when using API-key authentication instead of Codex login:
# OPENAI_API_KEY=replace-me
# CODEX_MODEL=

REVIEW_LANGUAGE=zh-CN
REVIEW_TIMEOUT_SECONDS=180
MAX_DIFF_BYTES=1048576
MAX_FINDINGS=40
MIN_CONFIDENCE=0.7
AUTO_RESOLVE_OBSOLETE=true
TRIGGER_ON_OPEN=true
TRIGGER_ON_PUSH=true
TRIGGER_ON_REOPEN=true
GITLAB_STATUS_NAME=codex-review
