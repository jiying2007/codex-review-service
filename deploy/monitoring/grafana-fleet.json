        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "codex_review_instance_ready",
            "legendFormat": "{{instance}}",
            "range": true
