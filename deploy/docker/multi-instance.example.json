{
  "schemaVersion": 2,
  "server": {
    "host": "0.0.0.0",
    "port": 8787,
    "sharedProcessTrustAcknowledged": true
  },
  "instances": [
    {
      "id": "primary",
      "configFile": "/etc/codex-review/primary.json",
      "homeDir": "/home/codex-review/primary",
      "secretFiles": {
        "GITLAB_API_TOKEN_FILE": "/run/secrets/gitlab_primary_api",
        "GITLAB_WEBHOOK_SIGNING_TOKEN_FILE": "/run/secrets/gitlab_primary_webhook"
      }
    },
    {
      "id": "sensor",
      "configFile": "/etc/codex-review/sensor.json",
      "homeDir": "/home/codex-review/sensor",
      "secretFiles": {
        "GITLAB_API_TOKEN_FILE": "/run/secrets/gitlab_sensor_api",
        "GITLAB_WEBHOOK_SIGNING_TOKEN_FILE": "/run/secrets/gitlab_sensor_webhook"
      }
    }
  ]
}
