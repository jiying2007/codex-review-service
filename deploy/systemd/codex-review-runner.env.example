# This file belongs only to the unprivileged Codex runner.
# It must NOT contain GitLab API/webhook credentials.
CODEX_RUNNER_SOCKET=/run/codex-review-runner/runner.sock
CODEX_PATH=codex
CODEX_HOME=/home/codex-review-runner/.codex
# Optional API-key mode instead of managed Codex login:
# OPENAI_API_KEY=replace-me
# CODEX_MODEL=
REVIEW_TIMEOUT_SECONDS=180
RUNNER_MAX_BODY_BYTES=8388608
CODEX_VERSION_POLICY=warn
# CODEX_ALLOWED_VERSION_PATTERN=^codex-cli 0\.\d+\.\d+$

# Optional egress proxy. In hardened production, restrict this runner's egress
# to the approved OpenAI endpoint/proxy and do not give it a route to GitLab.
# HTTPS_PROXY=http://egress-proxy.internal:3128
# NO_PROXY=127.0.0.1,localhost
