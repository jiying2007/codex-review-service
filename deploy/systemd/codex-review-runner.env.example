# Hardened Runner environment. Never place GitLab credentials here.
# The systemd unit reads non-secret Runner settings from /etc/codex-review/config.json.

# Optional API-key mode instead of managed `codex login` state.
# Production should use a protected absolute secret file.
# OPENAI_API_KEY_FILE=/etc/codex-review/secrets/openai-api-key
# OPENAI_API_KEY=replace-me
