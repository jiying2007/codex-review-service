# Include inside the operator-managed nginx http {} block. Replace DNS/cert
# paths and validate with nginx -t. This is not an auto-deployment instruction.
upstream codex_review_edge {
    server 127.0.0.1:8799;
    keepalive 16;
}
server {
    listen 443 ssl;
    server_name review.example.invalid;
    ssl_certificate /etc/codex-review/tls/ingress.crt;
    ssl_certificate_key /etc/codex-review/tls/ingress.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 10m;
    client_header_timeout 10s;
    client_body_timeout 15s;
    keepalive_timeout 5s;
    location ~ "^/webhooks/gitlab/[a-z][a-z0-9-]{0,31}$" {
        if ($request_method != POST) { return 405; }
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_request_buffering on;
        proxy_connect_timeout 3s;
        proxy_send_timeout 20s;
        proxy_read_timeout 35s;
        # Never automatically replay a write with an unknown remote outcome.
        proxy_next_upstream off;
        proxy_pass http://codex_review_edge;
    }
    location / { return 404; }
}
server {
    # Local collector or an explicitly authenticated management tunnel only.
    listen 127.0.0.1:9443 ssl;
    server_name review-management.example.invalid;
    ssl_certificate /etc/codex-review/tls/management.crt;
    ssl_certificate_key /etc/codex-review/tls/management.key;
    ssl_client_certificate /etc/codex-review/tls/monitoring-ca.crt;
    ssl_verify_client on;
    ssl_verify_depth 2;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 1k;
    client_header_timeout 10s;
    client_body_timeout 10s;
    keepalive_timeout 5s;
    location ~ "^/(metrics|version|repositories(/status)?|health/(live|ready|ingress|dependencies)|instances/[a-z][a-z0-9-]{0,31}/(metrics|version|health/(live|ready|dependencies)))$" {
        if ($request_method != GET) { return 405; }
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
        proxy_next_upstream off;
        proxy_pass http://codex_review_edge;
    }
    location / { return 404; }
}
