{
  "name": "codex-review-service",
  "version": "3.0.0",
  "private": true,
  "description": "Durable, self-hosted Codex code review service for GitLab merge requests",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "core:init": "git submodule update --init --recursive",
    "precheck": "npm run core:init",
    "pretest": "npm run core:init",
    "start": "node src/index.js",
    "start:runner": "node src/runner-server.js",
    "doctor": "node src/doctor.js",
    "check": "node --check src/*.js && node --check src/codex-safe-core/*.js && node --check test/*.test.js && node --check scripts/release.js",
    "test": "node --test test/*.test.js",
    "ci": "npm run check && npm test",
    "release:prepare": "node scripts/release.js prepare",
    "release:check": "node scripts/release.js check",
    "release:push": "node scripts/release.js push"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jiying2007/codex-review-service.git"
  }
}
