{
  "name": "codex-review-service",
  "version": "7.4.0",
  "private": true,
  "description": "Durable, self-hosted Codex code review service for GitLab merge requests",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.22.2 <23 || >=24.19.0 <25"
  },
  "files": [
    ".codex-safe.example.json",
    ".env.example",
    "CHANGELOG.md",
    "LICENSE",
    "LONG_TERM_ASSET.md",
    "OPERATIONS.md",
    "README.md",
    "README.zh-CN.md",
    "SUPPORT.md",
    "SECURITY.md",
    "VERIFY_RELEASE.md",
    "config.example.json",
    "product-contract.json",
    "deploy/systemd/config.example.json",
    "deploy/systemd/*.service",
    "deploy/systemd/*.env.example",
    "deploy/docker/Dockerfile",
    "deploy/docker/compose.yaml",
    "deploy/docker/README.md",
    "deploy/docker/config.example.json",
    "docs/ARCHITECTURE.md",
    "docs/DEPLOYMENT.md",
    "docs/DEPLOYMENT.zh-CN.md",
    "docs/NOTIFICATIONS.md",
    "docs/NOTIFICATIONS.zh-CN.md",
    "docs/FLOW_TRACKING.md",
    "docs/FLOW_TRACKING.zh-CN.md",
    "docs/GITLAB_SETUP.md",
    "docs/GITLAB_SETUP.zh-CN.md",
    "docs/TOKEN_EFFICIENCY.md",
    "docs/TOKEN_EFFICIENCY.zh-CN.md",
    "docs/CODEX_PROVIDER.md",
    "docs/CODEX_PROVIDER.zh-CN.md",
    "docs/PRODUCT_CONTRACT.md",
    "docs/QUALITY_PLATFORM.md",
    "docs/QUALITY_PLATFORM.zh-CN.md",
    "docs/STORAGE_AND_MIGRATIONS.md",
    "src/*.js",
    "src/codex-safe-core/index.js",
    "src/codex-safe-core/safe-contract.js",
    "src/codex-safe-core/judgment-lifecycle.js",
    "src/codex-safe-core/codex-runtime.js",
    "src/codex-safe-core/codex-cli.js",
    "src/codex-safe-core/process-runner.js",
    "src/codex-safe-core/context-builder.js",
    "src/codex-safe-core/efficiency-planner.js",
    "src/codex-safe-core/policy.js",
    "src/codex-safe-core/review-rules.js",
    "src/codex-safe-core/git-repository.js",
    "src/codex-safe-core/codex-safe.schema.json",
    "src/codex-safe-core/quality-platform.js",
    "src/codex-safe-core/review-profile-pack.js",
    "src/codex-safe-core/test-impact.js",
    "src/codex-safe-core/diagnosis-platform.js",
    "src/codex-safe-core/quality/profile-packs.json",
    "src/codex-safe-core/CHANGELOG.md",
    "src/codex-safe-core/LICENSE",
    "src/codex-safe-core/README.md",
    "src/codex-safe-core/README.zh-CN.md",
    "src/codex-safe-core/SECURITY.md",
    "src/codex-safe-core/core-contract.json",
    "src/codex-safe-core/family-non-goals.json",
    "src/codex-safe-core/family-error-taxonomy.json",
    "src/codex-safe-core/scripts/family-diagnostics.js",
    "src/codex-safe-core/scripts/verify-release-artifact.js"
  ],
  "scripts": {
    "core:init": "git submodule update --init --recursive",
    "precheck": "npm run core:init",
    "pretest": "npm run core:init",
    "start": "node src/index.js",
    "start:runner": "node src/runner-server.js",
    "doctor": "node src/doctor.js",
    "admin": "node src/admin-cli.js",
    "contract:verify": "node scripts/verify-product-contract.js",
    "governance": "node src/codex-safe-core/scripts/verify-actions-pins.js .github/workflows && node src/codex-safe-core/scripts/verify-non-goals.js .",
    "diagnostics": "node src/codex-safe-core/scripts/family-diagnostics.js",
    "test:fault": "node --test test/fault-injection.test.js",
    "check": "node scripts/check-syntax.js && node scripts/verify-family.js && node scripts/verify-product-contract.js && npm run docs:verify && node scripts/release.js verify && npm run governance",
    "test": "node --test test/*.test.js",
    "ci": "npm run check && npm test && npm run test:fault",
    "release:prepare": "node scripts/release.js prepare",
    "release:verify": "node scripts/release.js verify",
    "release:check": "node scripts/release.js check",
    "release:push": "node scripts/release.js push",
    "docs:generate": "node scripts/generate-contract-docs.js",
    "docs:verify": "node scripts/generate-contract-docs.js && git diff --exit-code -- README.md README.zh-CN.md docs/ARCHITECTURE.md docs/PRODUCT_CONTRACT.md"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jiying2007/codex-review-service.git"
  }
}
